# --- Local Postgres (Alembic + DB access) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/document_copilot

# --- JWT Auth ---
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- OpenAI (needed once the LLM / embedding layer is wired up) ---
OPENAI_API_KEY=sk-your-openai-api-key
# BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_MAX_CHUNK_TOKENS=512
OPENAI_CHAT_MODEL=gpt-5-mini

# --- Logging (structlog) ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- Agent (LLM orchestration) ---
AGENT_TEMPERATURE=0.2
AGENT_REASONING_EFFORT=low
AGENT_MAX_REQUESTS=20
AGENT_MAX_TOOL_CALLS=30
AGENT_OUTPUT_RETRIES=2

# --- Retrieval (hybrid search tuning) ---
RETRIEVAL_CANDIDATE_K=50
RETRIEVAL_TOP_K=10
RETRIEVAL_RRF_K=60
RETRIEVAL_NEIGHBOR_RADIUS=1
RETRIEVAL_SEMANTIC_MIN_SIMILARITY=0.0
RETRIEVAL_KEYWORD_MODEL=gpt-5-nano
RETRIEVAL_KEYWORD_TEMPERATURE=0.0

ALLOWED_ORIGINS=http://localhost:5173
